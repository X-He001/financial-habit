# Financial Habit systemd 服务单元
# 用法：把项目路径/用户名改成你自己的，然后：
#   sudo cp financial-habit.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now financial-habit
#
# 说明：
#   - 单进程同时托管前端(dist/)和 API（生产模式前后端一体）
#   - SQLite 数据文件默认在项目 server/data.sqlite
#   - 环境变量 PORT / DATA_DIR 可按需修改
#   - 崩溃自动重启（Restart=on-failure），开机自启（enable 后）

[Unit]
Description=Financial Habit (Vite+React+SQLite 个人财务后端与前端)
After=network.target

[Service]
Type=simple
# 改成你的项目路径
WorkingDirectory=/opt/financial-habit
ExecStart=/usr/bin/node server/index.js
# 如果用 nvm 安装的 Node，ExecStart 需指向 nvm 里的 node 绝对路径，如：
# ExecStart=/root/.nvm/versions/node/v20.x.x/bin/node server/index.js
Restart=on-failure
RestartSec=3
# 数据目录可单独指定（目录会自动创建，数据库放该目录下的 data.sqlite）
# Environment=DATA_DIR=/var/lib/financial-habit
Environment=NODE_ENV=production
# 运行用户（不建议用 root；给项目目录相应权限即可）
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
